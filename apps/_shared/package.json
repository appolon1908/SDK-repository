{
  "name": "@codestra/apps-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Codestra API client wiring, synthetic fixtures, and shared UI primitives for the ops dashboard, developer portal, and admin console apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src/ui/globals.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "default": "./dist/ui/index.js" },
    "./ui/AppShell": { "types": "./dist/ui/AppShell.d.ts", "default": "./dist/ui/AppShell.js" },
    "./ui/StubLoginPage": { "types": "./dist/ui/StubLoginPage.d.ts", "default": "./dist/ui/StubLoginPage.js" },
    "./ui/globals.css": "./src/ui/globals.css",
    "./auth": { "types": "./dist/auth/index.d.ts", "default": "./dist/auth/index.js" },
    "./fixtures": { "types": "./dist/fixtures/index.d.ts", "default": "./dist/fixtures/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codestra/connector-kit": "workspace:^",
    "@codestra/contracts": "workspace:^",
    "@codestra/social-sdk": "workspace:^"
  },
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
