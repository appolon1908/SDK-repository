{
  "name": "@codestra/middleware",
  "version": "0.1.0",
  "description": "Codestra Middleware: the sole cross-system write authority. Fastify + Prisma/PostgreSQL implementation of the public, enterprise connector, and webhook subscription contracts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@codestra/connector-kit": "workspace:^",
    "@codestra/contracts": "workspace:^",
    "@codestra/webhook-sdk": "workspace:^",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.3",
    "jose": "6.2.11",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "@prisma/adapter-pg": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
