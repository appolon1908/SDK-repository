  "productionActivationGates": [
    "Keycloak product clients exist with scoped service identities",
    "Kong validates Keycloak JWTs before Middleware routes",
    "Valid token, no token, invalid token, wrong scope, wrong caller target, and header enforcement matrix passes",
    "Generated Python, TypeScript, and PHP clients pass smoke tests",
    "Provider staging canaries pass with operation read-back evidence",
    "Secrets are installed through the external secret store only",
    "Backup restore evidence exists",
    "Rollback rehearsal evidence exists",
    "Observability alerts and dashboards are verified",
    "Live provider capability flags are enabled only after approval"
  ]
}
