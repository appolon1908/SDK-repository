  "credentialCertification": {
    "requiredClientRules": [
      "baseUrl must use HTTPS except loopback development",
      "baseUrl must reject username/password/query/fragment credential material",
      "access token must be supplied at request time through getAccessToken",
      "authorization must be sent as a bearer header only",
      "browser cookies and ambient credentials must be omitted",
      "tenant and correlation headers must be set on every request",
      "mutations must require Idempotency-Key"
    ],
    "forbiddenSourcePatterns": [
      "BEGIN PRIVATE KEY",
      "Bearer eyJ",
      "smtp://",
      "postgres://",
      "redis://",
      "password=",
      "client_secret="
    ]
  },
  "requiredOpenApiPaths": [
    "/v1/communications/messages",
    "/v1/communications/messages/{messageId}",
    "/v1/communications/messages/{messageId}/events",
    "/v1/communications/messages/{messageId}/cancel",
    "/v1/communications/templates",
    "/v1/communications/templates/{templateId}",
    "/v1/communications/templates/{templateId}/render",
    "/v1/communications/sender-identities",
    "/v1/communications/sender-identities/{senderIdentityId}",
    "/v1/communications/domains",
    "/v1/communications/domains/{domainId}",
    "/v1/communications/domains/{domainId}/verify",
    "/v1/communications/suppressions",
    "/v1/communications/suppressions/{suppressionId}",
    "/v1/communications/preferences",
    "/v1/communications/provider-health",
    "/v1/communications/usage",
    "/v1/communications/reputation"
