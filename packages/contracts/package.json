{
  "name": "@codestra/contracts",
  "version": "0.1.0",
  "description": "Canonical Codestra API, command, event, and error contracts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "../../contracts"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
